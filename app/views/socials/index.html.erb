<div class="socials-page">
  <div class="socials-header">
    <div class="socials-header__left">
      <h1 class="socials-header__title">Discover</h1>
    </div>
    <% if user_signed_in? %>
      <div class="socials-header__actions">
        <%= link_to business_ideas_path, class: "socials-share-btn" do %>
          <span>Share an idea</span>
          <svg width="13px" height="10px" viewBox="0 0 13 10">
            <path d="M1,5 L11,5"></path>
            <polyline points="8 1 12 5 8 9"></polyline>
          </svg>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @trending_posts.any? %>
    <div class="trending-section">
      <div class="trending-section__header">
        <span class="trending-section__label">🔥 Trending today</span>
      </div>
      <div class="trending-grid">
        <% @trending_posts.each do |post| %>
          <%= render "social_card", post: post, trending: true %>
        <% end %>
      </div>
    </div>
    <div class="trending-divider"></div>
  <% end %>

  <% if @posts.empty? && @trending_posts.empty? %>
    <div class="socials-empty">
      <p class="socials-empty__text">No projects shared yet. Be the first to share yours.</p>
      <% if user_signed_in? %>
        <%= link_to "Go to my projects →", business_ideas_path, class: "socials-empty__link" %>
      <% end %>
    </div>
  <% elsif @posts.any? %>
    <div class="socials-list">
      <% @posts.each do |post| %>
        <%= render "social_card", post: post %>
      <% end %>
    </div>
  <% end %>
</div>

<!-- Comments modal -->
<div id="commentsModal" class="comments-modal-overlay" aria-modal="true" role="dialog">
  <div class="comments-modal">
    <div class="comments-modal__header">
      <h3 class="comments-modal__title" id="commentsModalTitle">Comments</h3>
      <button class="comments-modal__close" id="closeCommentsModal" aria-label="Close comments">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="comments-modal__body" id="commentsModalBody">
      <div class="modal-loading">
        <div class="modal-loading__spinner"></div>
        <p>Loading comments…</p>
      </div>
    </div>
    <% if user_signed_in? %>
      <div class="comments-modal__form">
        <textarea id="commentInput" class="comments-modal__input" placeholder="Write a comment…" rows="2"></textarea>
        <button id="commentSubmit" class="comments-modal__submit">Post</button>
      </div>
    <% end %>
  </div>
</div>

<!-- Project preview modal -->
<div id="projectModal" class="project-modal-overlay" aria-modal="true" role="dialog">
  <div class="project-modal" id="projectModalBox">
    <button class="project-modal__close" id="closeModal" aria-label="Close preview">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="project-modal__body" id="modalBody">
      <div class="modal-loading">
        <div class="modal-loading__spinner"></div>
        <p>Loading project…</p>
      </div>
    </div>
  </div>
</div>

<script>
// Move modals to body so position:fixed works despite .page-content transform
document.body.appendChild(document.getElementById("commentsModal"));
document.body.appendChild(document.getElementById("projectModal"));

(function() {
  var overlay  = document.getElementById("projectModal");
  var modalBox = document.getElementById("projectModalBox");
  var body     = document.getElementById("modalBody");
  var closeBtn = document.getElementById("closeModal");
  var currentTab = 0;
  var modalTabController = null;

  // ── Open ──────────────────────────────────────────────────────────
  document.querySelectorAll("[data-preview-url]").forEach(function(card) {
    card.addEventListener("click", function() {
      openModal(card.dataset.previewUrl);
    });
  });

  function openModal(url) {
    body.innerHTML = '<div class="modal-loading"><div class="modal-loading__spinner"></div><p>Loading project…</p></div>';
    overlay.classList.add("active");
    document.body.style.overflow = "hidden";

    fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" } })
      .then(function(r) { return r.text(); })
      .then(function(html) {
        body.innerHTML = html;
        initModalTabs();
      })
      .catch(function() {
        body.innerHTML = '<div class="modal-error"><p>Could not load the project. Please try again.</p></div>';
      });
  }

  // ── Close ─────────────────────────────────────────────────────────
  function closeModal() {
    overlay.classList.remove("active");
    document.body.style.overflow = "";
    currentTab = 0;
    if (modalTabController) {
      modalTabController.destroy();
      modalTabController = null;
    }
  }

  closeBtn.addEventListener("click", closeModal);

  overlay.addEventListener("click", function(e) {
    if (e.target === overlay) closeModal();
  });

  document.addEventListener("keydown", function(e) {
    if (!overlay.classList.contains("active")) return;
    if (e.key === "Escape") { closeModal(); return; }
    if (modalTabController) {
      if (e.key === "ArrowDown") { e.preventDefault(); modalTabController.next(); }
      if (e.key === "ArrowUp")   { e.preventDefault(); modalTabController.prev(); }
    }
  });

  // ── Tab logic inside modal ────────────────────────────────────────
  function initModalTabs() {
    var layout    = body.querySelector(".modal-tab-layout");
    if (!layout) return;

    var indicator = layout.querySelector(".modal-tab-indicator");
    var pips      = indicator ? indicator.querySelectorAll(".tab-pip") : [];
    var panels    = layout.querySelectorAll(".modal-tab-panel");
    currentTab = 0;

    function switchTab(index) {
      if (index === currentTab) return;
      indicator.setAttribute("data-direction", index < currentTab ? "up" : "down");

      panels[currentTab].classList.remove("active");
      pips[currentTab].classList.remove("active");
      pips[currentTab].querySelector(".tab-pip__dot").classList.remove("active");

      currentTab = index;

      panels[currentTab].classList.add("active");
      pips[currentTab].classList.add("active");
      pips[currentTab].querySelector(".tab-pip__dot").classList.add("active");
    }

    pips.forEach(function(pip, i) {
      pip.addEventListener("click", function() { switchTab(i); });
    });

    // Scroll inside modal
    var scrollCooldown = false;
    body.addEventListener("wheel", function(e) {
      if (scrollCooldown) return;
      if (Math.abs(e.deltaY) < 30) return;
      if (e.deltaY > 0 && currentTab < panels.length - 1) {
        switchTab(currentTab + 1);
        scrollCooldown = true;
        setTimeout(function() { scrollCooldown = false; }, 700);
      } else if (e.deltaY < 0 && currentTab > 0) {
        switchTab(currentTab - 1);
        scrollCooldown = true;
        setTimeout(function() { scrollCooldown = false; }, 700);
      }
    });

    modalTabController = {
      next: function() { if (currentTab < panels.length - 1) switchTab(currentTab + 1); },
      prev: function() { if (currentTab > 0) switchTab(currentTab - 1); },
      destroy: function() {}
    };
  }
})();

// ── Comments modal ────────────────────────────────────────────
(function() {
  var overlay   = document.getElementById("commentsModal");
  var bodyEl    = document.getElementById("commentsModalBody");
  var titleEl   = document.getElementById("commentsModalTitle");
  var closeBtn  = document.getElementById("closeCommentsModal");
  var input     = document.getElementById("commentInput");
  var submitBtn = document.getElementById("commentSubmit");
  var currentUrl = null;

  window.openCommentsModal = function(btn) {
    currentUrl = btn.dataset.commentsUrl;
    var title  = btn.dataset.postTitle;
    titleEl.textContent = title;
    overlay.classList.add("active");
    document.body.style.overflow = "hidden";
    loadComments();
  };

  function loadComments() {
    bodyEl.innerHTML = '<div class="modal-loading"><div class="modal-loading__spinner"></div><p>Loading comments…</p></div>';
    fetch(currentUrl, { headers: { "X-Requested-With": "XMLHttpRequest" } })
      .then(function(r) { return r.text(); })
      .then(function(html) {
        bodyEl.innerHTML = html;
        bindDeleteButtons();
      })
      .catch(function() {
        bodyEl.innerHTML = '<div class="modal-error"><p>Could not load comments.</p></div>';
      });
  }

  function closeModal() {
    overlay.classList.remove("active");
    document.body.style.overflow = "";
    currentUrl = null;
    if (input) input.value = "";
  }

  closeBtn.addEventListener("click", closeModal);
  overlay.addEventListener("click", function(e) {
    if (e.target === overlay) closeModal();
  });
  document.addEventListener("keydown", function(e) {
    if (overlay.classList.contains("active") && e.key === "Escape") closeModal();
  });

  // Submit comment
  if (submitBtn && input) {
    submitBtn.addEventListener("click", postComment);
    input.addEventListener("keydown", function(e) {
      if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); postComment(); }
    });
  }

  function postComment() {
    var body = input.value.trim();
    if (!body || !currentUrl) return;
    submitBtn.disabled = true;

    var csrfToken = document.querySelector('meta[name="csrf-token"]');
    fetch(currentUrl, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-Requested-With": "XMLHttpRequest",
        "X-CSRF-Token": csrfToken ? csrfToken.content : ""
      },
      body: JSON.stringify({ comment: { body: body } })
    })
    .then(function(r) { return r.text(); })
    .then(function(html) {
      bodyEl.innerHTML = html;
      input.value = "";
      bindDeleteButtons();
      updateCardCount(currentUrl);
    })
    .catch(function() {
      alert("Could not post comment. Please try again.");
    })
    .finally(function() {
      submitBtn.disabled = false;
    });
  }

  function bindDeleteButtons() {
    bodyEl.querySelectorAll("[data-comment-delete]").forEach(function(btn) {
      btn.addEventListener("click", function() {
        if (!confirm("Delete this comment?")) return;
        var csrfToken = document.querySelector('meta[name="csrf-token"]');
        fetch(btn.dataset.commentDelete, {
          method: "DELETE",
          headers: {
            "X-Requested-With": "XMLHttpRequest",
            "X-CSRF-Token": csrfToken ? csrfToken.content : ""
          }
        })
        .then(function(r) { return r.text(); })
        .then(function(html) {
          bodyEl.innerHTML = html;
          bindDeleteButtons();
          updateCardCount(currentUrl);
        });
      });
    });
  }

  function updateCardCount(url) {
    var btns = document.querySelectorAll('[data-comments-url="' + url + '"]');
    fetch(url, { headers: { "X-Requested-With": "XMLHttpRequest" } })
      .then(function(r) { return r.text(); })
      .then(function(html) {
        var tmp = document.createElement("div");
        tmp.innerHTML = html;
        var items = tmp.querySelectorAll(".comment-item");
        btns.forEach(function(b) {
          var span = b.querySelector("span");
          if (span) span.textContent = items.length;
        });
      });
  }
})();

// ── Like toggle ──────────────────────────────────────────────
window.toggleLike = function(btn) {
  var url = btn.dataset.likeUrl;
  var liked = btn.dataset.liked === "true";
  var csrfToken = document.querySelector('meta[name="csrf-token"]');

  fetch(url, {
    method: liked ? "DELETE" : "POST",
    headers: {
      "X-Requested-With": "XMLHttpRequest",
      "X-CSRF-Token": csrfToken ? csrfToken.content : ""
    }
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    btn.dataset.liked = data.liked.toString();
    btn.classList.toggle("social-card__like-btn--liked", data.liked);
    var svg = btn.querySelector("svg");
    svg.setAttribute("fill", data.liked ? "currentColor" : "none");
    var span = btn.querySelector("span");
    if (span) span.textContent = data.count;
  });
};
</script>
