<div class="socials-page">
  <div class="socials-header">
    <div class="socials-header__left">
      <h1 class="socials-header__title">Share your <span class="socials-header__title-highlight">projects</span></h1>
    </div>
    <div class="socials-header__actions">
      <%= link_to socials_path, class: "socials-share-btn socials-share-btn--back" do %>
        <svg width="13px" height="10px" viewBox="0 0 13 10">
          <path d="M12,5 L2,5"></path>
          <polyline points="5 1 1 5 5 9"></polyline>
        </svg>
        <span>Back to Socials</span>
      <% end %>
    </div>
  </div>

  <% if @my_ideas.empty? %>
    <div class="socials-empty">
      <p class="socials-empty__text">No completed projects yet. Finish your first research to share it.</p>
      <%= link_to "Go to my projects →", business_ideas_path, class: "socials-empty__link" %>
    </div>
  <% else %>
    <div class="socials-list">
      <% @my_ideas.each do |idea| %>
        <div class="social-card social-card--selectable <%= 'social-card--shared' if idea.shared %>">
          <div class="social-card__left">
            <div class="social-card__avatar">
              <% if current_user.avatar.attached? %>
                <%= image_tag current_user.avatar, class: "social-card__avatar-img" %>
              <% else %>
                <span class="social-card__avatar-initials">
                  <%= current_user.first_name.present? ? current_user.first_name[0].upcase : current_user.email[0].upcase %>
                </span>
              <% end %>
            </div>
          </div>

          <div class="social-card__body">
            <h2 class="social-card__title">
              <%= idea.title.present? ? idea.title : idea.content.truncate(70) %>
            </h2>
            <p class="social-card__meta">
              <%= current_user.first_name.present? ? "#{current_user.first_name} #{current_user.last_name}".strip : current_user.email %>
              &nbsp;·&nbsp;<%= time_ago_in_words(idea.created_at) %> ago
            </p>
            <% if idea.summary.present? %>
              <p class="social-card__description"><%= idea.summary.truncate(140) %></p>
            <% end %>
          </div>

          <div class="social-card__right">
            <% pill_state = idea.shared ? "published" : "unpublished" %>
            <button
              type="button"
              class="social-card__publish-pill social-card__publish-pill--<%= pill_state %>"
              data-controller="share-pill"
              data-action="click->share-pill#toggle"
              data-share-url="<%= share_business_idea_path(idea) %>">
              <span class="social-card__status-dot"></span>
              <span class="pill-label"><%= idea.shared ? "Published" : "Unpublished" %></span>
            </button>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
