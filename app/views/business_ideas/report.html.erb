<div class="report-page">

  <div class="report-header">
    <p class="report-header__label">Business Plan</p>
    <h1 class="report-header__title">Entrepreneurial<br><em>Action Plan</em></h1>
    <p class="report-header__progress-label"><span id="report-checked-count">0</span> / <span id="report-total-count">0</span> completed</p>
    <div class="report-header__bar-bg">
      <div class="report-header__bar-fill" id="report-progress-bar"></div>
    </div>
  </div>

  <div class="report-sections">

    <div class="report-section">
      <p class="report-section__number">01</p>
      <button class="report-section__toggle" aria-expanded="false">
        <h2 class="report-section__title">Ideation &amp; Validation</h2>
        <svg class="report-section__chevron" width="16" height="16" viewBox="0 0 16 16" fill="none">
          <polyline points="4 6 8 10 12 6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <ul class="report-checklist">
        <li class="report-checklist__item"><label><input type="checkbox"><span>Define the problem you're solving and for whom</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Write the <strong>Lean Canvas</strong> (1 page)</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Identify and list direct and indirect competitors</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Produce a <strong>competitive analysis</strong> (matrix / mapping)</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Prepare a <strong>discovery questionnaire</strong> (10-15 questions)</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Conduct 20-30 interviews with your target audience</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Write a <strong>market research summary</strong> (size, trends, segments)</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Formulate your unique value proposition</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Document findings in an <strong>idea validation memo</strong></span></label></li>
      </ul>
    </div>

    <div class="report-section">
      <p class="report-section__number">02</p>
      <button class="report-section__toggle" aria-expanded="false">
        <h2 class="report-section__title">Business Plan &amp; Strategy</h2>
        <svg class="report-section__chevron" width="16" height="16" viewBox="0 0 16 16" fill="none">
          <polyline points="4 6 8 10 12 6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <ul class="report-checklist">
        <li class="report-checklist__item"><label><input type="checkbox"><span>Write the <strong>executive summary</strong> (1-2 pages)</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Complete the detailed <strong>Business Model Canvas</strong></span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Write the full <strong>business plan</strong> (market, strategy, team, operations)</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Build a <strong>3-year financial forecast</strong> (P&amp;L, cash flow, working capital, break-even)</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Define the pricing strategy</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Create the <strong>pitch deck</strong> (10-12 slides)</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Identify funding sources (bootstrapping, loans, grants, fundraising)</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Prepare a <strong>funding application package</strong> if needed</span></label></li>
      </ul>
    </div>

    <div class="report-section">
      <p class="report-section__number">03</p>
      <button class="report-section__toggle" aria-expanded="false">
        <h2 class="report-section__title">Legal &amp; Administrative</h2>
        <svg class="report-section__chevron" width="16" height="16" viewBox="0 0 16 16" fill="none">
          <polyline points="4 6 8 10 12 6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <ul class="report-checklist">
        <li class="report-checklist__item"><label><input type="checkbox"><span>Choose the legal structure (LLC, Corp, sole proprietorship…)</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Draft the <strong>articles of incorporation / company bylaws</strong></span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Draft a <strong>shareholders' agreement</strong> (if co-founders)</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Complete business registration and filing</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Open a business bank account</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>File for trademark registration → <strong>trademark certificate</strong></span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Draft the <strong>Terms of Service (ToS)</strong></span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Draft the <strong>Terms and Conditions / Sales Terms</strong></span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Draft the <strong>Privacy Policy</strong> (GDPR / CCPA compliant)</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Set up the <strong>legal notice / imprint</strong> on the website/app</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Get the necessary insurance (professional liability…)</span></label></li>
      </ul>
    </div>

    <div class="report-section">
      <p class="report-section__number">04</p>
      <button class="report-section__toggle" aria-expanded="false">
        <h2 class="report-section__title">Product Design &amp; Conception</h2>
        <svg class="report-section__chevron" width="16" height="16" viewBox="0 0 16 16" fill="none">
          <polyline points="4 6 8 10 12 6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <ul class="report-checklist">
        <li class="report-checklist__item"><label><input type="checkbox"><span>Write the <strong>functional specifications document</strong></span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>List and prioritize features in a <strong>product backlog</strong></span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Write <strong>user stories</strong> for each feature</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Create <strong>wireframes</strong> (user flows)</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Produce high-fidelity <strong>UI/UX mockups</strong></span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Write the <strong>technical specifications</strong> (stack, architecture, API)</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Build the <strong>product roadmap</strong> (MVP → V1 → V2)</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Define the MVP scope</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Create a <strong>clickable prototype</strong> to validate user journeys</span></label></li>
      </ul>
    </div>

    <div class="report-section">
      <p class="report-section__number">05</p>
      <button class="report-section__toggle" aria-expanded="false">
        <h2 class="report-section__title">Development &amp; Launch</h2>
        <svg class="report-section__chevron" width="16" height="16" viewBox="0 0 16 16" fill="none">
          <polyline points="4 6 8 10 12 6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <ul class="report-checklist">
        <li class="report-checklist__item"><label><input type="checkbox"><span>Set up the development environment</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Build the MVP based on the prioritized backlog</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Write the <strong>QA test plan</strong> (functional, performance, security)</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Execute tests and document results in a <strong>test report</strong></span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Write the <strong>technical documentation / API docs</strong></span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Prepare <strong>store listings</strong> (App Store / Google Play) if mobile app</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Write the <strong>go-to-market plan</strong></span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Define the launch timeline</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Set up analytics tools (tracking, key events)</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Ship the MVP / V1 to early users</span></label></li>
      </ul>
    </div>

    <div class="report-section">
      <p class="report-section__number">06</p>
      <button class="report-section__toggle" aria-expanded="false">
        <h2 class="report-section__title">Marketing &amp; Acquisition</h2>
        <svg class="report-section__chevron" width="16" height="16" viewBox="0 0 16 16" fill="none">
          <polyline points="4 6 8 10 12 6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <ul class="report-checklist">
        <li class="report-checklist__item"><label><input type="checkbox"><span>Write the <strong>marketing plan</strong> (channels, budget, calendar)</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Create the <strong>brand guidelines</strong> (logo, colors, typography, tone of voice)</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Write the <strong>editorial guidelines</strong> (tone, formats, frequency)</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Build a <strong>content plan</strong> (SEO, blog, social media)</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Create <strong>email templates</strong> (onboarding, newsletter, follow-up)</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Prepare a <strong>press kit</strong> (press release, visuals, pitch, founder bios)</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Set up acquisition campaigns (SEM, social ads…)</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Create a <strong>pre-launch landing page</strong> if needed</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Configure CRM and marketing automation tools</span></label></li>
      </ul>
    </div>

    <div class="report-section">
      <p class="report-section__number">07</p>
      <button class="report-section__toggle" aria-expanded="false">
        <h2 class="report-section__title">Operations &amp; Growth</h2>
        <svg class="report-section__chevron" width="16" height="16" viewBox="0 0 16 16" fill="none">
          <polyline points="4 6 8 10 12 6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <ul class="report-checklist">
        <li class="report-checklist__item"><label><input type="checkbox"><span>Define key KPIs and build a <strong>dashboard</strong></span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Set up <strong>monthly financial reporting</strong></span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Schedule regular <strong>product retrospectives</strong> (written summary)</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Collect and analyze user feedback</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Iterate on the product (new features, bug fixes)</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Prepare a <strong>fundraising deck / investor memo</strong> if scaling up</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Update the business plan and forecast based on actual results</span></label></li>
        <li class="report-checklist__item"><label><input type="checkbox"><span>Document internal processes in a <strong>wiki / operational playbook</strong></span></label></li>
      </ul>
    </div>

  </div>
</div>

<script>
(function() {
  // Accordion
  document.querySelectorAll('.report-section__toggle').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', !expanded);
      var list = btn.closest('.report-section').querySelector('.report-checklist');
      list.classList.toggle('report-checklist--open', !expanded);
    });
  });

  // Progress bar
  function updateProgress() {
    var all = document.querySelectorAll('.report-checklist input[type="checkbox"]');
    var checked = document.querySelectorAll('.report-checklist input[type="checkbox"]:checked');
    document.getElementById('report-total-count').textContent = all.length;
    document.getElementById('report-checked-count').textContent = checked.length;
    var pct = all.length > 0 ? Math.round(checked.length / all.length * 100) : 0;
    document.getElementById('report-progress-bar').style.width = pct + '%';
  }

  document.querySelectorAll('.report-checklist input[type="checkbox"]').forEach(function(cb) {
    cb.addEventListener('change', updateProgress);
  });

  updateProgress();
})();
</script>
