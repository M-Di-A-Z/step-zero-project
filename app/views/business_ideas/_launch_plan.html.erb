<% launch = data.launch_plan.is_a?(String) ? JSON.parse(data.launch_plan) : (data.launch_plan || {}) %>
<% phases = launch["phases"] || [] %>
<% phase1 = phases.find { |p| p["number"] == 1 } || {} %>
<% phase2 = phases.find { |p| p["number"] == 2 } || {} %>
<% phase3 = phases.find { |p| p["number"] == 3 } || {} %>
<% step_counter = [0] %>

<div class="launch-plan">

  <!-- Header -->
  <div class="launch-plan__header">
    <h1 class="launch-plan__title">Launch Plan</h1>
    <p class="launch-plan__subtitle">The key steps to start building <strong><%= idea.title %></strong></p>
  </div>

  <!-- 3 phases as equal columns -->
  <div class="launch-plan__columns">

    <!-- Phase 1 -->
    <div class="launch-plan__phase-card">
      <div class="launch-plan__phase-header">
        <span class="launch-plan__phase-badge launch-plan__phase-badge--orange">Phase <%= phase1["number"] || 1 %></span>
        <h3 class="launch-plan__phase-label"><%= phase1["label"] || "Define & validate" %></h3>
      </div>
      <ul class="launch-plan__steps">
        <% (phase1["steps"] || []).each do |step| %>
          <% step_counter[0] += 1 %>
          <li class="launch-plan__step">
            <span class="launch-plan__dot launch-plan__dot--orange"><%= step_counter[0] %></span>
            <span class="launch-plan__step-text"><%= step %></span>
          </li>
        <% end %>
      </ul>
    </div>

    <!-- Phase 2 -->
    <div class="launch-plan__phase-card">
      <div class="launch-plan__phase-header">
        <span class="launch-plan__phase-badge launch-plan__phase-badge--orange">Phase <%= phase2["number"] || 2 %></span>
        <h3 class="launch-plan__phase-label"><%= phase2["label"] || "Build the simplest version" %></h3>
      </div>
      <ul class="launch-plan__steps">
        <% (phase2["steps"] || []).each do |step| %>
          <% step_counter[0] += 1 %>
          <li class="launch-plan__step">
            <span class="launch-plan__dot launch-plan__dot--orange"><%= step_counter[0] %></span>
            <span class="launch-plan__step-text"><%= step %></span>
          </li>
        <% end %>
      </ul>
    </div>

    <!-- Phase 3 -->
    <div class="launch-plan__phase-card">
      <div class="launch-plan__phase-header">
        <span class="launch-plan__phase-badge launch-plan__phase-badge--orange">Phase <%= phase3["number"] || 3 %></span>
        <h3 class="launch-plan__phase-label"><%= phase3["label"] || "Launch" %></h3>
      </div>
      <% columns = phase3["columns"] || {} %>
      <div class="launch-plan__phase3-groups">
        <% ["Operations", "Growth", "Metrics"].each do |col_name| %>
          <% steps = columns[col_name] || [] %>
          <% next if steps.empty? %>
          <div class="launch-plan__step-group">
            <p class="launch-plan__step-group-label"><%= col_name %></p>
            <ul class="launch-plan__steps">
              <% steps.each do |step| %>
                <% step_counter[0] += 1 %>
                <li class="launch-plan__step">
                  <span class="launch-plan__dot launch-plan__dot--orange"><%= step_counter[0] %></span>
                  <span class="launch-plan__step-text"><%= step %></span>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
    </div>

  </div>

</div>
