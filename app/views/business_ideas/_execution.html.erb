<% execution = data.execution.is_a?(String) ? JSON.parse(data.execution) : (data.execution || {}) %>

<% tech_color = case execution["tech_feasibility_label"]&.downcase
   when "high" then "green"
   when "medium" then "yellow"
   when "low" then "red"
   end %>

<% risk_color = case execution["regulatory_risk_level"]&.downcase
   when "low" then "green"
   when "medium" then "yellow"
   when "high" then "red"
   end %>

<div class="execution">

  <!-- Header -->
  <div class="execution__header">
    <h1 class="execution__title">Execution</h1>
    <p class="execution__subtitle">Feasibility and risk assessment for <strong><%= idea.title %></strong></p>
  </div>

  <!-- Row 1: Tech Feasibility + Regulatory Risk -->
  <div class="execution__metrics">

    <div class="execution__card">
      <p class="execution__card-label">Tech Feasibility</p>
      <span class="<%= "project-show__pill project-show__pill--#{tech_color} execution__key-pill" %>"><%= execution["tech_feasibility_label"] || "n/a" %></span>
      <p class="execution__card-context"><%= sanitize(execution["tech_feasibility_context"] || "n/a", tags: %w[strong]) %></p>
    </div>

    <div class="execution__card">
      <p class="execution__card-label">Regulatory Risk</p>
      <span class="<%= "project-show__pill project-show__pill--#{risk_color} execution__key-pill" %>"><%= execution["regulatory_risk_level"] || "n/a" %></span>
      <p class="execution__card-context"><%= sanitize(execution["regulatory_risk_context"] || "n/a", tags: %w[strong]) %></p>
    </div>

  </div>

  <!-- Row 2: Tech Challenge (full-width) -->
  <div class="execution__card execution__card--full">
    <p class="execution__card-label">Tech Challenge</p>
    <p class="execution__challenge-value"><%= execution["tech_challenge"] || "n/a" %></p>
  </div>

  <!-- Row 3: Key Risk -->
  <div class="execution__risk">
    <p class="execution__risk-label">Key Risk</p>
    <p class="execution__risk-text">
      <%= sanitize(execution["key_risk"] || "n/a", tags: %w[strong]) %>
    </p>
  </div>

</div>
