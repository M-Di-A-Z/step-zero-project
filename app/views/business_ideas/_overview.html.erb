<% overview = data.overview.is_a?(String) ? JSON.parse(data.overview) : (data.overview || {}) %>

<% feasibility_dots = case overview["project_feasibility"]&.downcase
   when "low" then 2
   when "medium" then 3
   when "high" then 5
   else 3
   end %>

<div class="project-show">
  <!-- Header: title + summary left, rating right -->
  <div class="project-show__header">
    <div class="project-show__header-left">
      <h1 class="project-show__title">
        The project <span class="project-show__title-highlight"><%= idea.title %></span>
      </h1>
      <p class="project-show__summary"><%= idea.summary %></p>
    </div>

    <%# Gauge: 270° arc (from 135° to 405°), radius 45, center 60,60 %>
    <% radius = 45 %>
    <% circumference = 2 * Math::PI * radius %>
    <% arc_length = circumference * 0.75 %>
    <% score = idea.idea_score.to_f.clamp(0, 100) %>
    <% offset = arc_length - (arc_length * score / 100.0) %>
    <div class="project-show__rating">
      <div class="project-show__gauge">
        <svg viewBox="0 0 120 120" class="project-show__gauge-svg">
          <circle cx="60" cy="60" r="<%= radius %>"
                  fill="none" stroke="#e0ddd6" stroke-width="8" stroke-linecap="round"
                  stroke-dasharray="<%= arc_length.round(2) %> <%= circumference.round(2) %>"
                  transform="rotate(135 60 60)" />
          <circle cx="60" cy="60" r="<%= radius %>"
                  fill="none" stroke="#1a1a1a" stroke-width="8" stroke-linecap="round"
                  stroke-dasharray="<%= arc_length.round(2) %> <%= circumference.round(2) %>"
                  stroke-dashoffset="<%= offset.round(2) %>"
                  transform="rotate(135 60 60)" />
        </svg>
        <div class="project-show__gauge-value"><%= idea.idea_score %>%</div>
      </div>
    </div>
  </div>

  <!-- link to launch plan -->
  <div class="project-report_link">
    <%= link_to report_business_idea_path(idea), class: "home-submit" do %>
      <span>View Launch Plan</span>
      <svg width="15px" height="10px" viewBox="0 0 13 10">
        <path d="M1,5 L11,5"></path>
        <polyline points="8 1 12 5 8 9"></polyline>
      </svg>
    <% end %>
  </div>
  <!-- 3 data cards -->
  <div class="project-show__cards">


    <!-- Card 1: Market Stage -->
    <div class="project-show__card">
      <p class="project-show__card-label">Market Stage</p>
      <h2 class="project-show__card-heading"><%= overview["market_stage_pill"] || "n/a" %></h2>
      <p class="project-show__card-context"><strong><%= overview["market_stage_label"] %></strong> — <%= sanitize(overview["market_stage_context"] || "n/a", tags: %w[strong]) %></p>
    </div>

    <!-- Card 2: Competitivity -->
    <div class="project-show__card">
      <p class="project-show__card-label">Competitivity</p>
      <div class="project-show__card-visual">
        <div class="project-show__dash-bar">
          <% 5.times do |i| %>
            <span class="project-show__dash <%= i < overview["competitive_intensity_dots"].to_i ? 'project-show__dash--filled' : 'project-show__dash--empty' %>"></span>
          <% end %>
        </div>
      </div>
      <h2 class="project-show__card-heading"><%= overview["competitive_intensity_label"] || "n/a" %></h2>
      <p class="project-show__card-context"><%= sanitize(overview["competitive_intensity_context"] || "n/a", tags: %w[strong]) %></p>
    </div>

    <!-- Card 3: Project Feasibility -->
    <div class="project-show__card">
      <p class="project-show__card-label">Project Feasibility</p>
      <div class="project-show__card-visual">
        <div class="project-show__dash-bar">
          <% 5.times do |i| %>
            <span class="project-show__dash <%= i < feasibility_dots ? 'project-show__dash--filled' : 'project-show__dash--empty' %>"></span>
          <% end %>
        </div>
      </div>
      <h2 class="project-show__card-heading"><%= overview["project_feasibility"] || "n/a" %></h2>
      <p class="project-show__card-context"><%= sanitize(overview["project_feasibility_context"] || "n/a", tags: %w[strong]) %></p>
    </div>

  </div>

</div>
