<% overview = data.overview.is_a?(String) ? JSON.parse(data.overview) : data.overview %>

<% feasibility_dots = case overview["project_feasibility"]&.downcase
   when "low" then 2
   when "medium" then 3
   when "high" then 5
   else 3
   end %>

<div class="project-show">

  <!-- Header: title + summary left, rating right -->
  <div class="project-show__header">
    <div class="project-show__header-left">
      <h1 class="project-show__title">
        The project <span class="project-show__title-highlight"><%= idea.title %></span>
      </h1>
      <p class="project-show__summary"><%= idea.summary %></p>
    </div>

    <%# Gauge: 270° arc (from 135° to 405°), radius 45, center 60,60 %>
    <% radius = 45 %>
    <% circumference = 2 * Math::PI * radius %>
    <% arc_length = circumference * 0.75 %>
    <% score = idea.idea_score.to_f.clamp(0, 100) %>
    <% offset = arc_length - (arc_length * score / 100.0) %>
    <div class="project-show__rating">
      <div class="project-show__gauge">
        <svg viewBox="0 0 120 120" class="project-show__gauge-svg">
          <circle cx="60" cy="60" r="<%= radius %>"
                  fill="none" stroke="#e0ddd6" stroke-width="8" stroke-linecap="round"
                  stroke-dasharray="<%= arc_length.round(2) %> <%= circumference.round(2) %>"
                  transform="rotate(135 60 60)" />
          <circle cx="60" cy="60" r="<%= radius %>"
                  fill="none" stroke="#1a1a1a" stroke-width="8" stroke-linecap="round"
                  stroke-dasharray="<%= arc_length.round(2) %> <%= circumference.round(2) %>"
                  stroke-dashoffset="<%= offset.round(2) %>"
                  transform="rotate(135 60 60)" />
        </svg>
        <div class="project-show__gauge-value"><%= idea.idea_score %>%</div>
      </div>
      <p class="project-show__rating-label">Rating</p>
    </div>
  </div>

  <!-- 3 data cards -->
  <div class="project-show__cards">

    <!-- Card 1: Market Stage -->
    <div class="project-show__card">
      <p class="project-show__card-label">Market Stage</p>
      <div class="project-show__card-visual">
        <span class="project-show__pill project-show__pill--green"><%= overview["market_stage_pill"] %></span>
      </div>
      <h2 class="project-show__card-heading"><%= overview["market_stage_label"] %></h2>
      <p class="project-show__card-context"><%= overview["market_stage_context"] %></p>
    </div>

    <!-- Card 2: Competitivity -->
    <div class="project-show__card">
      <p class="project-show__card-label">Competitivity</p>
      <div class="project-show__card-visual">
        <div class="project-show__dash-bar">
          <% 5.times do |i| %>
            <span class="project-show__dash <%= i < overview["competitive_intensity_dots"] ? 'project-show__dash--filled' : 'project-show__dash--empty' %>"></span>
          <% end %>
        </div>
      </div>
      <h2 class="project-show__card-heading"><%= overview["competitive_intensity_label"] %></h2>
      <p class="project-show__card-context"><%= overview["competitive_intensity_context"] %></p>
    </div>

    <!-- Card 3: Project Feasibility -->
    <div class="project-show__card">
      <p class="project-show__card-label">Project Feasibility</p>
      <div class="project-show__card-visual">
        <div class="project-show__dash-bar">
          <% 5.times do |i| %>
            <span class="project-show__dash <%= i < feasibility_dots ? 'project-show__dash--filled' : 'project-show__dash--empty' %>"></span>
          <% end %>
        </div>
      </div>
      <h2 class="project-show__card-heading"><%= overview["project_feasibility"] %></h2>
      <p class="project-show__card-context"><%= overview["project_feasibility_context"] %></p>
    </div>

  </div>

  <!-- Generate Plan button -->
  <div class="project-show__generate">
    <button class="generate-btn">
      <div class="dots_border"></div>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="sparkle">
        <path class="path" stroke-linejoin="round" stroke-linecap="round" stroke="black" fill="black" d="M14.187 8.096L15 5.25L15.813 8.096C16.0231 8.83114 16.4171 9.50062 16.9577 10.0413C17.4984 10.5819 18.1679 10.9759 18.903 11.186L21.75 12L18.904 12.813C18.1689 13.0231 17.4994 13.4171 16.9587 13.9577C16.4181 14.4984 16.0241 15.1679 15.814 15.903L15 18.75L14.187 15.904C13.9769 15.1689 13.5829 14.4994 13.0423 13.9587C12.5016 13.4181 11.8321 13.0241 11.097 12.814L8.25 12L11.096 11.187C11.8311 10.9769 12.5006 10.5829 13.0413 10.0423C13.5819 9.50162 13.9759 8.83214 14.186 8.097L14.187 8.096Z"></path>
        <path class="path" stroke-linejoin="round" stroke-linecap="round" stroke="black" fill="black" d="M6 14.25L5.741 15.285C5.59267 15.8785 5.28579 16.4206 4.85319 16.8532C4.42059 17.2858 3.87853 17.5927 3.285 17.741L2.25 18L3.285 18.259C3.87853 18.4073 4.42059 18.7142 4.85319 19.1468C5.28579 19.5794 5.59267 20.1215 5.741 20.715L6 21.75L6.259 20.715C6.40725 20.1216 6.71398 19.5796 7.14639 19.147C7.5788 18.7144 8.12065 18.4075 8.714 18.259L9.75 18L8.714 17.741C8.12065 17.5925 7.5788 17.2856 7.14639 16.853C6.71398 16.4204 6.40725 15.8784 6.259 15.285L6 14.25Z"></path>
        <path class="path" stroke-linejoin="round" stroke-linecap="round" stroke="black" fill="black" d="M6.5 4L6.303 4.5915C6.24777 4.75718 6.15472 4.90774 6.03123 5.03123C5.90774 5.15472 5.75718 5.24777 5.5915 5.303L5 5.5L5.5915 5.697C5.75718 5.75223 5.90774 5.84528 6.03123 5.96877C6.15472 6.09226 6.24777 6.24282 6.303 6.4085L6.5 7L6.697 6.4085C6.75223 6.24282 6.84528 6.09226 6.96877 5.96877C7.09226 5.84528 7.24282 5.75223 7.4085 5.697L8 5.5L7.4085 5.303C7.24282 5.24777 7.09226 5.15472 6.96877 5.03123C6.84528 4.90774 6.75223 4.75718 6.697 4.5915L6.5 4Z"></path>
      </svg>
      <span class="text_button">Generate plan</span>
    </button>
  </div>

</div>
