<nav class="navbar-home">
  <div class="navbar-home-logo">
    <%= link_to root_path do %>
      <%= image_tag "Fichier 4@4x.png", alt: "StepZero", class: "navbar-home-logo__img" %>
    <% end %>
  </div>
  <ul class="navbar-home-links">
    <li><%= link_to "Home", root_path, class: "navbar-home-link #{'navbar-home-link--active' if current_page?(root_path)}" %></li>
    <li><%= link_to "My Ideas", user_signed_in? ? business_ideas_path : new_user_session_path, class: "navbar-home-link #{'navbar-home-link--active' if user_signed_in? && current_page?(business_ideas_path)}" %></li>
    <li><%= link_to "Discover", socials_path, class: "navbar-home-link #{'navbar-home-link--active' if current_page?(socials_path)}" %></li>
  </ul>
  <div class="navbar-home-right">
    <% if user_signed_in? %>
      <%= link_to profile_path, class: "navbar-home-avatar" do %>
          <% if current_user.avatar.attached? %>
            <%= image_tag current_user.avatar, class: "navbar-home-avatar__img" %>
          <% else %>
            <span class="navbar-home-avatar__initials">
              <%= current_user.first_name.present? ? current_user.first_name[0].upcase : current_user.email[0].upcase %>
            </span>
          <% end %>
      <% end %>
    <% else %>
      <%= link_to "Log In", new_user_session_path, class: "navbar-home-btn navbar-home-btn--outline" %>
      <%= link_to "Sign Up", new_user_registration_path, class: "navbar-home-btn navbar-home-btn--primary" %>
    <% end %>
  </div>
</nav>
