<div class="profile-page">
  <div class="profile-edit">
    <h1 class="profile-edit__title">Profile</h1>

    <%= form_with model: @user, url: profile_path, method: :patch, class: "profile-edit__form", data: { turbo: false } do |f| %>
      <% if @user.errors.any? %>
        <div class="profile-edit__errors">
          <% @user.errors.full_messages.each do |msg| %>
            <p><%= msg %></p>
          <% end %>
        </div>
      <% end %>

      <div class="profile-edit__avatar-field">
        <div class="profile-edit__avatar-preview">
          <% if @user.avatar.attached? %>
            <%= image_tag @user.avatar, class: "profile-edit__avatar-img" %>
          <% else %>
            <span class="profile-edit__avatar-initials">
              <%= @user.first_name.present? ? @user.first_name[0].upcase : @user.email[0].upcase %><%= @user.last_name.present? ? @user.last_name[0].upcase : "" %>
            </span>
          <% end %>
        </div>
        <div class="profile-edit__avatar-upload">
          <%= f.label :avatar, "Profile photo", class: "profile-edit__label" %>
          <%= f.file_field :avatar, accept: "image/*", class: "profile-edit__file-input" %>
        </div>
      </div>

      <div class="profile-edit__row">
        <div class="profile-edit__field">
          <%= f.label :first_name, "First name", class: "profile-edit__label" %>
          <%= f.text_field :first_name, class: "profile-edit__input", placeholder: "John" %>
        </div>
        <div class="profile-edit__field">
          <%= f.label :last_name, "Last name", class: "profile-edit__label" %>
          <%= f.text_field :last_name, class: "profile-edit__input", placeholder: "Doe" %>
        </div>
      </div>

      <div class="profile-edit__field">
        <%= f.label :email, "Email", class: "profile-edit__label" %>
        <%= f.email_field :email, class: "profile-edit__input" %>
      </div>

      <div class="profile-edit__actions">
        <%= f.submit "Save changes", class: "profile-edit__save-btn" %>
      </div>
    <% end %>
  </div>

  <!-- Log out -->
  <div class="profile-logout">
    <%= button_to "Log out", destroy_user_session_path, method: :delete, class: "profile-logout__btn" %>
  </div>
</div>
