<div class="profile-page">
  <!-- Header -->
  <div class="profile-header">
    <div class="profile-header__avatar">
      <% if @user.avatar.attached? %>
        <%= image_tag @user.avatar, class: "profile-header__avatar-img" %>
      <% else %>
        <span class="profile-header__initials">
          <%= @user.first_name.present? ? @user.first_name[0].upcase : @user.email[0].upcase %><%= @user.last_name.present? ? @user.last_name[0].upcase : "" %>
        </span>
      <% end %>
    </div>
    <div class="profile-header__info">
      <h1 class="profile-header__name">
        <% if @user.first_name.present? || @user.last_name.present? %>
          <%= @user.first_name %> <%= @user.last_name %>
        <% else %>
          <%= @user.email.split("@").first.capitalize %>
        <% end %>
      </h1>
      <p class="profile-header__email"><%= @user.email %></p>
      <p class="profile-header__joined">Member since <%= @user.created_at.strftime("%B %Y") %></p>
    </div>
    <%= link_to edit_profile_path, class: "profile-header__edit-btn" do %>
      <span>Edit profile</span>
      <svg width="13px" height="10px" viewBox="0 0 13 10">
        <path d="M1,5 L11,5"></path>
        <polyline points="8 1 12 5 8 9"></polyline>
      </svg>
    <% end %>
  </div>

  <!-- Stats -->
  <div class="profile-stats">
    <div class="profile-stats__card">
      <span class="profile-stats__number"><%= @completed_projects %></span>
      <span class="profile-stats__label">Projects</span>
    </div>
    <div class="profile-stats__card">
      <span class="profile-stats__number"><%= @shared_projects %></span>
      <span class="profile-stats__label">Shared</span>
    </div>
    <div class="profile-stats__card">
      <span class="profile-stats__number"><%= @average_score %><span class="profile-stats__max">/100</span></span>
      <span class="profile-stats__label">Avg. Score</span>
    </div>
  </div>

  <!-- Projects list -->
  <div class="profile-projects">
    <div class="profile-projects__header">
      <h2 class="profile-projects__title">My Projects</h2>
      <span class="profile-projects__count"><%= @completed_projects %> idea<%= @completed_projects == 1 ? "" : "s" %></span>
    </div>

    <% if @business_ideas.empty? %>
      <div class="profile-projects__empty">
        <p>No ideas yet.</p>
        <%= link_to "Start your first idea →", root_path, class: "profile-projects__empty-link" %>
      </div>
    <% else %>
      <div class="profile-projects__list">
        <% @business_ideas.each do |idea| %>
          <%= link_to (idea.status == "complete" ? business_idea_path(idea) : "#"), class: "profile-project-row" do %>
            <div class="profile-project-row__left">
              <h3 class="profile-project-row__name"><%= idea.title.present? ? idea.title : idea.content.truncate(40) %></h3>
              <p class="profile-project-row__summary"><%= idea.summary.present? ? idea.summary.truncate(80) : "—" %></p>
            </div>
            <div class="profile-project-row__right">
              <span class="profile-project-row__status profile-project-row__status--<%= idea.status %>">
                <%= idea.status.capitalize %>
              </span>
              <% if idea.idea_score.present? %>
                <span class="profile-project-row__score"><%= idea.idea_score %></span>
              <% end %>
              <span class="profile-project-row__arrow">→</span>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Log out -->
  <div class="profile-logout">
    <%= button_to "Log out", destroy_user_session_path, method: :delete, class: "profile-logout__btn" %>
  </div>
</div>
