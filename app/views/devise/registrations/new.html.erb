<div class="auth-page">
  <div class="auth-card">
    <h2 class="auth-title">Create your account</h2>
    <p class="auth-subtitle">Start validating your business ideas with AI.</p>

    <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>
      <%= f.error_notification %>

      <div class="auth-field">
        <label class="auth-label">Email</label>
        <%= f.input :email,
                    label: false,
                    required: true,
                    autofocus: true,
                    input_html: { autocomplete: "email", class: "auth-input", placeholder: "you@example.com" } %>
      </div>

      <div class="auth-field">
        <label class="auth-label">Password</label>
        <%= f.input :password,
                    label: false,
                    required: true,
                    hint: ("#{@minimum_password_length} characters minimum" if @minimum_password_length),
                    input_html: { autocomplete: "new-password", class: "auth-input", placeholder: "At least 6 characters" } %>
      </div>

      <div class="auth-field">
        <label class="auth-label">Confirm password</label>
        <%= f.input :password_confirmation,
                    label: false,
                    required: true,
                    input_html: { autocomplete: "new-password", class: "auth-input", placeholder: "Repeat your password" } %>
      </div>

      <div class="auth-actions">
        <%= f.button :submit, "Sign up", class: "auth-submit" %>
      </div>
    <% end %>

    <div class="auth-links">
      <p>Already have an account? <%= link_to "Log in", new_session_path(resource_name), class: "auth-link" %></p>
    </div>
  </div>
</div>
