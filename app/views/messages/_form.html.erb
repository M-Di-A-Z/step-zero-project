<%= simple_form_for [chat, message], html: { class: "chat-form", data: { turbo_frame: "_top" } } do |f| %>
  <div class="chat-chatbar">
    <%= f.input :content, as: :string, label: false, placeholder: "",
        wrapper_html: { class: "chat-input-wrapper" },
        input_html: { class: "chat-input",
          data: { controller: "submit-on-enter placeholder-typer", action: "keydown->submit-on-enter#handleKeydown" } } %>
    <button type="submit" class="home-submit">
      <span>SEND</span>
      <svg width="15px" height="10px" viewBox="0 0 13 10">
        <path d="M1,5 L11,5"></path>
        <polyline points="8 1 12 5 8 9"></polyline>
      </svg>
    </button>
  </div>
<% end %>
