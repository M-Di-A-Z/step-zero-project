<% content_for(:body_class) { "home-body" } %>

<%= turbo_frame_tag "idea-flow", data: { turbo_action: "advance" } do %>
  <div class="home-page">
    <div class="home-content">
      <h1 class="home-title">
        I've got this idea,
        <br>
        <span class="home-title-typewriter" id="typewriter"></span><span class="home-title-cursor">|</span>
      </h1>

      <script>
        document.addEventListener("turbo:load", () => {
          const el = document.getElementById("typewriter");
          if (!el) return;

          const sentences = [
            "a B2B SaaS that automates invoice chasing for small agencies",
            "an AI copilot for solo real estate agents in secondary cities",
            "a marketplace connecting retired engineers with startups",
            "a mental health app built for night-shift nurses",
            "a tool that turns Slack threads into project briefs",
            "a subscription box for curated vintage watch collectors",
            "a no-code loyalty program builder for restaurants",
            "a platform for independent pharmacists to co-buy generics",
            "an AI that detects burnout risk from calendar patterns",
            "a SaaS helping EU companies comply with AI regulations"
          ];
          let sentenceIndex = 0;
          let charIndex = 0;
          let deleting = false;
          const pauseAfterType = 2000;
          const pauseAfterDelete = 400;
          const typeSpeed = 45;
          const deleteSpeed = 25;

          function type() {
            const current = sentences[sentenceIndex];
            if (!deleting) {
              el.textContent = current.slice(0, charIndex + 1);
              charIndex++;
              if (charIndex === current.length) {
                setTimeout(() => { deleting = true; type(); }, pauseAfterType);
                return;
              }
              setTimeout(type, typeSpeed);
            } else {
              el.textContent = current.slice(0, charIndex - 1);
              charIndex--;
              if (charIndex === 0) {
                deleting = false;
                sentenceIndex = (sentenceIndex + 1) % sentences.length;
                setTimeout(type, pauseAfterDelete);
                return;
              }
              setTimeout(type, deleteSpeed);
            }
          }
          type();
        });
      </script>

      <%= form_with url: business_ideas_path, method: :post, scope: :business_idea, class: "home-form", data: { turbo: false } do |f| %>
        <div class="home-chatbar">
          <%= f.text_field :content,
              placeholder: "",
              class: "home-input",
              required: true,
              autocomplete: "off",
              data: { controller: "submit-on-enter", action: "keydown->submit-on-enter#handleKeydown" } %>
          <%= f.button type: "submit", class: "home-submit" do %>
            <span>CHECK</span>
            <svg width="15px" height="10px" viewBox="0 0 13 10">
              <path d="M1,5 L11,5"></path>
              <polyline points="8 1 12 5 8 9"></polyline>
            </svg>
          <% end %>
        </div>
      <% end %>
    </div>

  </div>

<% end %>
