<% content_for(:body_class) { "home-body" } %>
<div class="home-bg" style="background-image: url('<%= asset_path("background.jpg") %>');"></div>
<div class="home-page">
  <div class="home-content">
    <h1 class="home-title">Type in project <span class="home-title-accent">idea...</span></h1>

    <%= form_with url: business_ideas_path, method: :post, class: "home-form" do |f| %>
      <div class="home-chatbar">
        <%= f.text_field :content,
            placeholder: "",
            class: "home-input",
            required: true,
            autocomplete: "off" %>
        <%= f.button type: "submit", class: "home-submit" do %>
          <span class="home-submit-dot"></span>
          <span class="home-submit-label">CHECK</span>
          <span class="home-submit-arrow">→</span>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
